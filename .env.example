# --- Entorno ---------------------------------------------------------------
# development | production | test
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Zona horaria del cron diario (APScheduler)
TIMEZONE=Europe/Madrid

# --- Scheduler -------------------------------------------------------------
ENABLE_SCHEDULER=true

# --- Scraping: proveedor por portal ---------------------------------------
# Mapa portal=proveedor, separado por comas:
#   local  -> scraper propio por HTTP (sin Apify, sin credenciales)
#   idealista-api -> Search API oficial (solo con acceso aprobado por Idealista)
#   apify  -> actor de Apify (requiere APIFY_TOKEN)
#   none   -> portal desactivado
# Portales no listados = desactivados. `local` existe para Fotocasa.
SCRAPER_PROVIDERS=idealista=apify,fotocasa=local
# Si una fuente propia falla (bloqueo, cambio de formato) o devuelve 0 anuncios,
# se reintenta con Apify para ese portal. Requiere APIFY_TOKEN.
SCRAPER_FALLBACK_TO_APIFY=true
SCRAPER_MAX_ITEMS=40
# Páginas de búsqueda que se recorren como máximo (30 anuncios por página).
SCRAPER_MAX_PAGES=5
SCRAPER_TIMEOUT_SECONDS=20
SCRAPER_MAX_RETRIES=2
# Peticiones por minuto contra cada portal (cortesía y anti-bloqueo).
SCRAPER_RATE_LIMIT_PER_MINUTE=20
# SCRAPER_USER_AGENT=
# Egreso alternativo (proxy residencial o relay): útil desde IP de datacenter.
# SCRAPER_PROXY_URL=
# Segmento de ubicación de Fotocasa si el texto libre no resuelve (p. ej. alcobendas).
# SCRAPER_FOTOCASA_LOCATION_SEGMENT=

# Credenciales de Idealista Search API, solo tras recibir aprobación oficial.
# No configures `idealista=idealista-api` antes de validar el acceso y contrato.
# IDEALISTA_API_CLIENT_ID=
# IDEALISTA_API_CLIENT_SECRET=

# --- Apify (proveedor de respaldo / actores) --------------------------------
APIFY_TOKEN=
# Actores verificados en vivo (mismo autor; el scraper adapta entrada y salida).
APIFY_IDEALISTA_ACTOR=igolaizola/idealista-scraper
# Déjalo vacío para omitir Fotocasa de la búsqueda.
APIFY_FOTOCASA_ACTOR=igolaizola/fotocasa-scraper
# rent (alquiler) | sale (compraventa)
SEARCH_OPERATION=sale
APIFY_MAX_ITEMS=40
APIFY_TIMEOUT_SECONDS=300
# Tope de gasto por ejecución de actor, en USD (descomenta para limitarlo).
# APIFY_MAX_CHARGE_USD=0.50

# --- Geocodificación (radio por código postal) ------------------------------
# Servicio público CartoCiudad (IGN/CNIG). No requiere API key.
GEOCODING_BASE_URL=https://www.cartociudad.es/geocoder/api/geocoder
GEOCODING_TIMEOUT_SECONDS=10

# --- DeepSeek (clasificación) ---------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
# Umbral mínimo de relevancia (0.0-1.0) para aceptar un anuncio
RELEVANCE_THRESHOLD=0.6
# Directorio de resultados en JSON (vacío = solo en memoria).
RESULTS_DIR=data/results

# --- Perfil de búsqueda (job diario + UI) ---------------------------------
# Cuerpo JSON equivalente a POST /api/v1/searches. Es el perfil de FÁBRICA: se usa
# mientras nadie guarde criterios desde la UI (PUT /api/v1/search-profile). Lo usan
# el cron de las 07:00, la UI (botón "Ejecutar búsqueda") y
# POST /api/v1/search-profile/run. Debe ir en una sola línea.
# Déjalo VACÍO (SEARCH_PROFILE_JSON=) para volver a los criterios DAILY_* de abajo.
SEARCH_PROFILE_JSON={"location":"Madrid","portals":["idealista","fotocasa"],"max_price_eur":900000,"min_size_m2":140,"min_rooms":4,"max_results":50,"preferences":"Casa o chalet, padel cominitario, piscina comunitaria","must_have":["padel"],"postal_code":"28031","radius_km":5,"min_year_built":2020}
# Fichero del perfil guardado desde la UI (vacío = junto a RESULTS_DIR,
# p. ej. /data/search-profile.json en Kubernetes).
# SEARCH_PROFILE_FILE=

# --- Alertas push de viviendas nuevas (app ntfy: iPhone y Android) ----------
# El job de las 07:00 envía UNA notificación resumen con las viviendas que no
# salieron en la ejecución programada anterior. Instala la app "ntfy" en el móvil
# (App Store / Google Play) y suscríbete al mismo topic.
ALERTS_ENABLED=false
# Servidor ntfy (https://ntfy.sh para uso personal; o una instancia propia).
NTFY_BASE_URL=https://ntfy.sh
# Topic = "dirección" de tu móvil. Largo y difícil de adivinar si usas ntfy.sh.
# Debe coincidir letra a letra con la app: ntfy distingue MAYÚSCULAS de minúsculas
# (casa-nueva-AbC y casa-nueva-abc son topics distintos). Usa solo minúsculas si
# lo vas a teclear en el móvil.
NTFY_TOPIC=
# Solo si el topic está protegido con token en el servidor ntfy.
NTFY_TOKEN=
# Prioridad de la notificación: 1 (mínima) a 5 (urgente).
NTFY_PRIORITY=3
# URL que abre la notificación al tocarla (vacío = la primera vivienda nueva).
# ALERT_CLICK_URL=https://oaichousefinder.duckdns.org

# --- Búsqueda diaria por defecto (solo si SEARCH_PROFILE_JSON está vacío) --
DAILY_SEARCH_LOCATION=Madrid
DAILY_SEARCH_PORTALS=idealista,fotocasa
DAILY_MAX_PRICE_EUR=1500
DAILY_MIN_SIZE_M2=60
DAILY_MIN_ROOMS=2
DAILY_MAX_RESULTS=40
DAILY_PREFERENCES=
# Requisitos OBLIGATORIOS del job diario (AND), separados por comas.
# Se buscan en título, descripción y comodidades; si falta alguno, el anuncio se descarta
# antes del LLM. Vacío = sin filtro duro. Ejemplo: piscina,padel
DAILY_MUST_HAVE=
# Términos deseables (no excluyentes), separados por comas: se destacan y van primero.
DAILY_PREFERRED_TERMS=
# Tipos de vivienda del cron (vacío = todos): piso, atico, duplex, adosado, pareado,
# independiente, villa, casa de campo, apartamento, loft.
DAILY_HOME_TYPES=
# Radio geográfico del cron: CP y radio deben configurarse juntos (vacío = sin radio).
DAILY_POSTAL_CODE=
DAILY_RADIUS_KM=
# Año mínimo de construcción del cron (vacío = sin filtro).
DAILY_MIN_YEAR_BUILT=
# Certificado energético mínimo del cron: A (mejor) a G (peor); "B" = B o mejor.
DAILY_MAX_ENERGY_RATING=
