# --- Entorno ---------------------------------------------------------------
# development | production | test
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Zona horaria del cron diario (APScheduler)
TIMEZONE=Europe/Madrid

# --- Scheduler -------------------------------------------------------------
ENABLE_SCHEDULER=true

# --- Apify (scraping) ------------------------------------------------------
APIFY_TOKEN=
# Actores verificados (mismo autor, esquemas distintos: el scraper los adapta solo).
APIFY_IDEALISTA_ACTOR=igolaizola/idealista-scraper
# Déjalo vacío para omitir Fotocasa de la búsqueda.
APIFY_FOTOCASA_ACTOR=igolaizola/fotocasa-scraper
# rent (alquiler) | sale (compraventa)
SEARCH_OPERATION=sale
APIFY_MAX_ITEMS=40
APIFY_TIMEOUT_SECONDS=300
# Tope de gasto por ejecución de actor, en USD (descomenta para limitarlo).
# APIFY_MAX_CHARGE_USD=0.50

# --- Geocodificación (radio por código postal) ------------------------------
# Servicio público CartoCiudad (IGN/CNIG). No requiere API key.
GEOCODING_BASE_URL=https://www.cartociudad.es/geocoder/api/geocoder
GEOCODING_TIMEOUT_SECONDS=10

# --- DeepSeek (clasificación) ---------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
# Umbral mínimo de relevancia (0.0-1.0) para aceptar un anuncio
RELEVANCE_THRESHOLD=0.6
# Directorio de resultados en JSON (vacío = solo en memoria).
RESULTS_DIR=data/results

# --- Búsqueda diaria por defecto ------------------------------------------
DAILY_SEARCH_LOCATION=Madrid
DAILY_SEARCH_PORTALS=idealista,fotocasa
DAILY_MAX_PRICE_EUR=1500
DAILY_MIN_SIZE_M2=60
DAILY_MIN_ROOMS=2
DAILY_MAX_RESULTS=40
DAILY_PREFERENCES=
# Requisitos OBLIGATORIOS del job diario (AND), separados por comas.
# Se buscan en título, descripción y comodidades; si falta alguno, el anuncio se descarta
# antes del LLM. Vacío = sin filtro duro. Ejemplo: piscina,padel
DAILY_MUST_HAVE=
# Radio geográfico del cron: CP y radio deben configurarse juntos (vacío = sin radio).
DAILY_POSTAL_CODE=
DAILY_RADIUS_KM=
# Año mínimo de construcción del cron (vacío = sin filtro).
DAILY_MIN_YEAR_BUILT=
