# --- Entorno ---------------------------------------------------------------
# development | production | test
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Zona horaria del cron diario (APScheduler)
TIMEZONE=Europe/Madrid

# --- Scheduler -------------------------------------------------------------
ENABLE_SCHEDULER=true

# --- Apify (scraping) ------------------------------------------------------
APIFY_TOKEN=
# Identificador del actor de tu cuenta de Apify para cada portal
# (sustitúyelo por el actor real que quieras usar).
APIFY_IDEALISTA_ACTOR=idealista-scraper
APIFY_FOTOCASA_ACTOR=fotocasa-scraper
# rent (alquiler) | sale (compraventa)
SEARCH_OPERATION=rent
APIFY_MAX_ITEMS=40
APIFY_TIMEOUT_SECONDS=300

# --- DeepSeek (clasificación) ---------------------------------------------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60

# --- Búsqueda diaria por defecto ------------------------------------------
DAILY_SEARCH_LOCATION=Madrid
DAILY_SEARCH_PORTALS=idealista,fotocasa
DAILY_MAX_PRICE_EUR=1500
DAILY_MIN_SIZE_M2=60
DAILY_MIN_ROOMS=2
DAILY_MAX_RESULTS=40
DAILY_PREFERENCES=
