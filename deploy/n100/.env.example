# Configuración del despliegue en el N100 (cópiala a .env junto al compose).
# NO subas el .env con tokens reales al repositorio.

# --- Docker Compose --------------------------------------------------------
# Puerto del host donde escucha la UI/API (debe estar libre en el N100).
HOST_PORT=8000
TZ=Europe/Madrid

# --- Entorno de la aplicación ---------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
TIMEZONE=Europe/Madrid
ENABLE_SCHEDULER=true

# --- Apify (scraping) ------------------------------------------------------
APIFY_TOKEN=replace-me
APIFY_IDEALISTA_ACTOR=igolaizola/idealista-scraper
APIFY_FOTOCASA_ACTOR=igolaizola/fotocasa-scraper
SEARCH_OPERATION=sale
APIFY_MAX_ITEMS=40
APIFY_TIMEOUT_SECONDS=600
APIFY_MAX_CHARGE_USD=0.15

# --- Geocodificación (radio por código postal) -----------------------------
GEOCODING_BASE_URL=https://www.cartociudad.es/geocoder/api/geocoder
GEOCODING_TIMEOUT_SECONDS=10

# --- DeepSeek (clasificación) ---------------------------------------------
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_TIMEOUT_SECONDS=60
RELEVANCE_THRESHOLD=0.6

# --- Persistencia ----------------------------------------------------------
# Ruta DENTRO del contenedor; el compose monta ./data del host en /data.
RESULTS_DIR=/data/results

# --- Perfil de búsqueda (job diario + UI) ---------------------------------
# Misma semántica que en el resto del proyecto; debe ir en una sola línea.
SEARCH_PROFILE_JSON={"location":"Madrid","portals":["idealista","fotocasa"],"max_price_eur":900000,"min_size_m2":140,"min_rooms":4,"max_results":50,"preferences":"Casa o chalet, padel cominitario, piscina comunitaria","must_have":["padel"],"postal_code":"28031","radius_km":5,"min_year_built":2020}
